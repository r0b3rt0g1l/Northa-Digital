# URL canónica del sitio (metadata, sitemap, robots y OpenGraph).
# Si no se define, se usa https://northa-landing.vercel.app.
NEXT_PUBLIC_SITE_URL=https://northa-landing.vercel.app

# Web3Forms: clave pública de acceso para el formulario de contacto.
# Créala en https://web3forms.com con el correo que recibirá los mensajes,
# pégala aquí y en Vercel (Production y Preview) y vuelve a desplegar.
NEXT_PUBLIC_WEB3FORMS_KEY=
